INSPECTION_API_BASE_URL=https://your-provider.example/v1
INSPECTION_API_KEY=replace-with-your-key
INSPECTION_MODEL=your-configured-model

# 相对路径基于 agent-new；有空格的路径可使用双引号。
BATCH_INPUT_DIR=阶段1测试集
BATCH_OUTPUT_DIR=result/阶段1
BATCH_WORK_DIR=work/阶段1
# 同时处理4份报告，每份报告内部模型请求并发为1。
BATCH_WORKERS=4
BATCH_REQUEST_CONCURRENCY=1
